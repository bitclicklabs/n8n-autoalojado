# Copia este archivo como .env y rellénalo:   cp .env.example .env
# NUNCA subas el .env a git ni lo enseñes en pantalla.
# Genera cada secreto NUEVO con:   openssl rand -hex 32
# (hex en lugar de base64: sin / + ni =, que dan problemas en URLs de conexión)

# ─────────────────────────────────────────────────────────────
# 1. URL pública — elige UN bloque y deja los otros comentados
# ─────────────────────────────────────────────────────────────

# A) Local, solo tú (sin webhooks desde internet)
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678/
N8N_PROXY_HOPS=0
N8N_SECURE_COOKIE=false

# B) Local + túnel de Cloudflare (webhooks públicos)  →  docker compose --profile tunnel up -d
# N8N_HOST=n8n.tudominio.com
# N8N_PROTOCOL=https
# N8N_PUBLIC_URL=https://n8n.tudominio.com/
# N8N_PROXY_HOPS=1
# N8N_SECURE_COOKIE=true
# CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_token_del_tunel

# C) VPS con dominio + HTTPS automático  →  docker compose --profile vps up -d
# N8N_HOST=n8n.tudominio.com
# N8N_PROTOCOL=https
# N8N_PUBLIC_URL=https://n8n.tudominio.com/
# N8N_PROXY_HOPS=1
# N8N_SECURE_COOKIE=true
# SSL_EMAIL=tu@email.com

# Puerto local (solo en 127.0.0.1, nunca expuesto a internet)
N8N_LOCAL_PORT=5678

# ─────────────────────────────────────────────────────────────
# 2. General
# ─────────────────────────────────────────────────────────────
GENERIC_TIMEZONE=Europe/Madrid
# Fija una versión concreta en producción (por ejemplo 2.x.y) y actualiza a propósito
N8N_IMAGE_TAG=stable

# ─────────────────────────────────────────────────────────────
# 3. Secretos — genera cada uno con: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# Cifra TODAS tus credenciales de n8n. Si la pierdes, las pierdes todas.
# Guárdala en tu gestor de contraseñas, fuera del servidor.
N8N_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# Postgres: superusuario (solo para el arranque inicial)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
POSTGRES_DB=n8n

# Postgres: usuario con el que se conecta n8n (lo crea init-data.sh)
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
